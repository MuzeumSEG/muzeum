layout: null
---
[{% for e in site.exhibits %}
  {
    "id": {{ e.slug | jsonify }},
    "title": {{ e.title | jsonify }},
    "inv": {{ e.inv | jsonify }},
    "type": {{ e.type | jsonify }},
    "photos": {{ e.photos | jsonify }},
    "stamp": {{ e.stamp | jsonify }},
    "dating": {{ e.dating | jsonify }},
    "year": {{ e.year | jsonify }},
    "manufacturer": {{ e.manufacturer | jsonify }},
    "material": {{ e.material | jsonify }},
    "size": {{ e.size | jsonify }},
    "object": {{ e.object | jsonify }},
    "address": {{ e.address | jsonify }},
    "added": {{ e.added | jsonify }},
    "sources": {{ e.sources | jsonify }},
    "body": {{ e.content | markdownify | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
