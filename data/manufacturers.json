---
layout: null
---
[{% for m in site.manufacturers %}
  {
    "id": {{ m.slug | jsonify }},
    "name": {{ m.name | jsonify }},
    "country": {{ m.country | jsonify }},
    "city": {{ m.city | jsonify }},
    "years": {{ m.years | jsonify }},
    "stamps": {{ m.stamps | jsonify }},
    "identified": {{ m.identified | jsonify }},
    "sources": {{ m.sources | jsonify }},
    "body": {{ m.content | markdownify | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
